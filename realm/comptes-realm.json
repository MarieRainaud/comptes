{
  "realm": "comptes",
  "displayName": "Atelier de ninette",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 43200,
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername(undefined) and notEmail(undefined)",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "loginTheme": "atelier",
  "emailTheme": "keycloak",
  "eventsEnabled": true,
  "eventsExpiration": 604800,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "clients": [
    {
      "clientId": "gestionnaire-financier",
      "name": "Gestionnaire financier",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${FINANCE_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${FINANCE_ORIGIN}/auth/callback"
      ],
      "webOrigins": [],
      "rootUrl": "${FINANCE_ORIGIN}",
      "baseUrl": "${FINANCE_ORIGIN}/",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${FINANCE_ORIGIN}/",
        "backchannel.logout.url": "${FINANCE_BACKCHANNEL_URL}",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "acr",
        "roles",
        "profile",
        "email"
      ],
      "optionalClientScopes": []
    }
  ],
  "accountTheme": "atelier"
}
